# Copy to .env for local development (never commit .env).
# On Vercel, add the same names under Project → Settings → Environment Variables.

# The HS256 key that signs the session cookie. Required: 32+ random characters
# (any password manager's generator is fine).
SESSION_SECRET=

# Optional fallback login while no owner account exists.
# Normally you do not need these: open /admin.html and the first visit lets you
# create the single owner account, which is stored (hashed) in
# assets/data/admin.json.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Local development only: write changes straight to the files in assets/data.
# Leave this unset on Vercel.
ALLOW_LOCAL_STORE=1

# Publishing saves and the owner account from the deployed admin panel.
# Create a fine-grained GitHub token with "Contents: Read and write" on this repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
