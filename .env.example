# Copy to .env for local development (never commit .env).
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Username for the admin panel (defaults to "admin" when unset).
ADMIN_USERNAME=admin

# Password hash for the admin panel. Generate it with:
#   node scripts/hash-password.mjs "your long admin password"
ADMIN_PASSWORD_HASH=

# Random signing key for the session cookie (32+ characters). Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local development only: write changes straight to assets/data/content.json.
# Leave this unset on Vercel.
ALLOW_LOCAL_STORE=1

# Publishing saves from the deployed admin panel (needed on Vercel, not locally).
# Create a fine-grained GitHub token with "Contents: Read and write" on this repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
